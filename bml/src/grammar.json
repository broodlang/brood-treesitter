{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "bml",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "component"
        },
        {
          "type": "SYMBOL",
          "name": "element"
        },
        {
          "type": "SYMBOL",
          "name": "interpolation"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "component": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "component_self_closing"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "component_open"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_node"
              }
            },
            {
              "type": "SYMBOL",
              "name": "component_close"
            }
          ]
        }
      ]
    },
    "component_open": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<."
        },
        {
          "type": "SYMBOL",
          "name": "component_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "component_self_closing": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<."
        },
        {
          "type": "SYMBOL",
          "name": "component_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        },
        {
          "type": "STRING",
          "value": "/>"
        }
      ]
    },
    "component_close": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</."
        },
        {
          "type": "SYMBOL",
          "name": "component_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "component_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z][a-zA-Z0-9/_-]*"
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^<{\\s][^<{]*"
        }
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<!--"
          },
          {
            "type": "PATTERN",
            "value": "([^-]|-[^-]|--[^>])*"
          },
          {
            "type": "STRING",
            "value": "-->"
          }
        ]
      }
    },
    "element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "void_element"
        },
        {
          "type": "SYMBOL",
          "name": "self_closing_element"
        },
        {
          "type": "SYMBOL",
          "name": "full_element"
        }
      ]
    },
    "full_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "start_tag"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "SYMBOL",
          "name": "end_tag"
        }
      ]
    },
    "void_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "area"
              },
              {
                "type": "STRING",
                "value": "base"
              },
              {
                "type": "STRING",
                "value": "br"
              },
              {
                "type": "STRING",
                "value": "col"
              },
              {
                "type": "STRING",
                "value": "embed"
              },
              {
                "type": "STRING",
                "value": "hr"
              },
              {
                "type": "STRING",
                "value": "img"
              },
              {
                "type": "STRING",
                "value": "input"
              },
              {
                "type": "STRING",
                "value": "link"
              },
              {
                "type": "STRING",
                "value": "meta"
              },
              {
                "type": "STRING",
                "value": "param"
              },
              {
                "type": "STRING",
                "value": "source"
              },
              {
                "type": "STRING",
                "value": "track"
              },
              {
                "type": "STRING",
                "value": "wbr"
              }
            ]
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ">"
            },
            {
              "type": "STRING",
              "value": "/>"
            }
          ]
        }
      ]
    },
    "self_closing_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        },
        {
          "type": "STRING",
          "value": "/>"
        }
      ]
    },
    "start_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "end_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "tag_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z][a-zA-Z0-9-]*"
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "="
                },
                {
                  "type": "SYMBOL",
                  "name": "_attribute_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "attribute_name": {
      "type": "PATTERN",
      "value": "[^\\s/>=\"'{}]+"
    },
    "_attribute_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "quoted_value"
        },
        {
          "type": "SYMBOL",
          "name": "interpolation"
        }
      ]
    },
    "quoted_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "interpolation"
              },
              {
                "type": "SYMBOL",
                "name": "attribute_text"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "attribute_text": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^\"{]+"
        }
      }
    },
    "interpolation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_interp_part"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_interp_part": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "interp_braces"
        },
        {
          "type": "SYMBOL",
          "name": "interp_string"
        },
        {
          "type": "SYMBOL",
          "name": "interp_text"
        }
      ]
    },
    "interp_braces": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_interp_part"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "interp_string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "PATTERN",
            "value": "(\\\\.|[^\"\\\\])*"
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "interp_text": {
      "type": "PATTERN",
      "value": "[^{}\"]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
