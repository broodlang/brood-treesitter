{
  "grammars": [
    {
      "name": "brood",
      "camelcase": "Brood",
      "scope": "source.brood",
      "path": ".",
      "file-types": [
        "blsp"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Brood language (.blsp)",
    "links": {
      "repository": "https://github.com/broodlang/brood-treesitter"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
